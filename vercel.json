{
  "version": 2,
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": [
        "src/**",
        "public/**",
        "files/**",
        "_config.php",
        "router.php",
        "home.php",
        "search.php",
        "filter.php",
        "404.php"
      ]
    },
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": [
        "src/**",
        "public/**",
        "files/**",
        "_config.php",
        "router.php",
        "home.php",
        "search.php",
        "filter.php",
        "404.php"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.php?__route__=$1"
    }
  ]
}
